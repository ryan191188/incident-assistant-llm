# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Postgres / Redis (hostnames match docker-compose services).
# When running Django on the host instead, use localhost:5433 (Postgres) and localhost:6379 (Redis).
DATABASE_URL=postgres://incident:incident@db:5432/incident
REDIS_URL=redis://redis:6379/0

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set to http://localstack:4566 when running with `--profile aws`
AWS_ENDPOINT_URL=
CLOUDWATCH_LOG_GROUPS=
RDS_TRACE_DB_URL=
DEPLOY_EVENTBRIDGE_QUEUE_URL=
DEPLOY_AMI_COMMIT_TAG_KEY=CommitSHA
DEPLOY_WEBHOOK_SECRET=

# Git provider (not needed for CodeCommit)
GITHUB_TOKEN=
GIT_PROVIDER_API_URL=https://api.github.com

# Claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=#incidents

# RCA cost control (ARCHITECTURE.md §9.8)
RCA_DEBOUNCE_SECONDS=45
RCA_MIN_INTERVAL_SECONDS=120
RCA_MAX_RUNS_PER_INCIDENT=5
LLM_CIRCUIT_BREAKER_THRESHOLD=20
RCA_CACHE_TTL_SECONDS=3600
